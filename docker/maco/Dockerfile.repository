# syntax=docker/dockerfile:1
ARG CONTROL_IMAGE
FROM ${CONTROL_IMAGE}
USER root
ARG OPENCODE_VERSION
RUN test -f /app/server/dist/execution/repository-execution-main.js \
    && test -n "$OPENCODE_VERSION" \
    && node -e 'if (!/^\d+\.\d+\.\d+$/.test(process.argv[1])) process.exit(1)' "$OPENCODE_VERSION" \
    && npm install --global "opencode-ai@${OPENCODE_VERSION}" \
    && apt-get update && apt-get install -y --no-install-recommends git util-linux openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/verrail-repository \
    && chown 1000:1000 /var/lib/verrail-repository \
    && chmod 700 /var/lib/verrail-repository
COPY docker/maco/repository-entrypoint.sh /usr/local/lib/verrail/repository-entrypoint.sh
ENV OPENCODE_VERSION=${OPENCODE_VERSION} VERRAIL_REPOSITORY_ROOT=/var/lib/verrail-repository
USER 1000:1000
ENTRYPOINT ["sh", "/usr/local/lib/verrail/repository-entrypoint.sh"]
