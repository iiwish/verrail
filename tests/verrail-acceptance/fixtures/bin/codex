#!/usr/bin/env node

let prompt = "";

process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => {
  prompt += chunk;
});

process.on("SIGTERM", () => {
  process.exit(143);
});

process.stdin.on("end", () => {
  if (prompt.includes("[acceptance-empty]")) return;

  const emitResponse = () => {
    process.stdout.write(`${JSON.stringify({
      type: "item.completed",
      item: {
        type: "agent_message",
        text: "Acceptance runtime response",
      },
    })}\n`);
  };

  if (prompt.includes("[acceptance-slow]")) {
    setTimeout(emitResponse, 10_000);
    return;
  }

  emitResponse();
});
