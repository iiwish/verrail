DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# Go Domain API and durable orchestration. Keep the internal token private.
# VERRAIL_DOMAIN_API_TOKEN=replace-with-a-long-random-token
# VERRAIL_DOMAIN_API_LISTEN=127.0.0.1:3211
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=default
# VERRAIL_TEMPORAL_TASK_QUEUE=verrail-target-v1
# TEMPORAL_API_KEY=
# TEMPORAL_TLS_SERVER_NAME=
# VERRAIL_OUTBOX_POLL_INTERVAL=250ms
# VERRAIL_OUTBOX_LEASE_DURATION=30s
# VERRAIL_OUTBOX_MAX_ATTEMPTS=8
# VERRAIL_OUTBOX_BACKOFF_BASE=1s
# VERRAIL_OUTBOX_BACKOFF_MAX=1m

# One-command local full stack (`pnpm dev:verrail`). These ports intentionally
# avoid the default PostgreSQL and Temporal ports used by focused development.
# VERRAIL_DEV_POSTGRES_PORT=55432
# VERRAIL_DEV_TEMPORAL_GRPC_PORT=57233
# VERRAIL_DEV_TEMPORAL_UI_PORT=58233
# VERRAIL_DEV_COMPOSE_PROJECT=verrail-dev
# VERRAIL_DEV_DATABASE_URL=postgres://verrail:verrail@127.0.0.1:55432/verrail
# VERRAIL_DEV_KEEP_INFRA=false

# Process-wide protection for expensive full-tree workspace Git scans.
# PAPERCLIP_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# PAPERCLIP_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# PAPERCLIP_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# PAPERCLIP_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
